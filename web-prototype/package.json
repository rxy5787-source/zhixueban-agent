{
  "name": "zhixueban-web-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode static-demo --outDir dist-pages",
    "build:offline": "tsc --noEmit && vite build --mode offline-study --outDir dist-offline && node scripts/build-offline-worker.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
